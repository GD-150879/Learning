@model Learning.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<h1>Employee Details</h1>

<div class="mb-3">
    <strong>First Name:</strong> @Model.FirstName
</div>
<div class="mb-3">
    <strong>Last Name:</strong> @Model.LastName
</div>
<div class="mb-3">
    <strong>Date of Birth:</strong> @Model.DateOfBirth.ToString("yyyy-MM-dd")
</div>
<div class="mb-3">
    <strong>Address:</strong> @Model.Address
</div>
<div class="mb-3">
    <strong>Phone:</strong> @Model.Phone
</div>
<div class="mb-3">
    <strong>Email:</strong> @Model.Email
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
