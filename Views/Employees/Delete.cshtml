@model Learning.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<h1>Delete Employee</h1>

<h4>Are you sure you want to delete this employee?</h4>

<div class="mb-3">
    <strong>First Name:</strong> @Model.FirstName
</div>
<div class="mb-3">
    <strong>Last Name:</strong> @Model.LastName
</div>
<div class="mb-3">
    <strong>Date of Birth:</strong> @Model.DateOfBirth.ToString("yyyy-MM-dd")
</div>
<div class="mb-3">
    <strong>Address:</strong> @Model.Address
</div>
<div class="mb-3">
    <strong>Phone:</strong> @Model.Phone
</div>
<div class="mb-3">
    <strong>Email:</strong> @Model.Email
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
